@inject Workspace Workspace
@inject IFileDialogService Dialogs
@inject StartupOptions Startup

<div class="panel start">
    <h2>開始</h2>
    <p class="muted">賽事檔（.tourney）會自動儲存：每個動作都立即寫入檔案，不需要按「儲存」。</p>
    <div class="page-header">
        <button class="primary new-tournament" @onclick="() => _creating = true">新增賽事…</button>
        <button class="open-tournament" @onclick="OpenAsync">開啟賽事檔…</button>
    </div>
</div>

@if (_creating)
{
    <NewTournamentForm OnDone="() => _creating = false" />
}

@if (_lock is { } decision)
{
    <LockPrompt Decision="decision" OnResolved="Resolve" />
}

@code {
    private bool _creating;
    private Core.Locking.LockDecision? _lock;
    private string? _pendingPath;

    protected override void OnInitialized()
    {
        if (Startup.OpenPath is { } path)
        {
            Startup.OpenPath = null;
            OpenPath(path);
        }
    }

    private void OpenAsync()
    {
        if (Dialogs.PickTournamentToOpen() is not { } path)
            return;
        OpenPath(path);
    }

    /// <summary>先檢查鎖定；需要使用者決定時顯示提示。</summary>
    public void OpenPath(string path)
    {
        var decision = Workspace.CheckLock(path);
        if (decision.Kind == Core.Locking.LockDecisionKind.Acquire)
        {
            Workspace.Open(path);
            return;
        }

        _pendingPath = path;
        _lock = decision;
    }

    private void Resolve(LockPrompt.Answer answer)
    {
        var path = _pendingPath;
        _lock = null;
        _pendingPath = null;
        if (answer.Proceed && path is not null)
            Workspace.Open(path, answer.ConfirmedStale, answer.ForceText);
    }
}
