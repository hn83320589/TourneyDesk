@using TourneyDesk.Core.Locking

<Modal Title="賽事檔已被鎖定">
    <ChildContent>
        <p class="lock-message">@Decision.Message</p>
        @if (Decision.Kind == LockDecisionKind.RequireForceConfirmation)
        {
            <p>請輸入確認字串：<strong>@LockArbiter.ForceConfirmationText</strong></p>
            <input class="force-text" @bind="_typed" @bind:event="oninput" aria-label="確認字串" />
        }
    </ChildContent>
    <Actions>
        <button @onclick="() => OnResolved.InvokeAsync(new Answer(false, false, null))">@(Decision.Kind == LockDecisionKind.Denied ? "關閉" : "取消")</button>
        @if (Decision.Kind == LockDecisionKind.ConfirmStaleTakeover)
        {
            <button class="primary take-over" @onclick="() => OnResolved.InvokeAsync(new Answer(true, true, null))">接手並開啟</button>
        }
        else if (Decision.Kind == LockDecisionKind.RequireForceConfirmation)
        {
            <button class="danger force" disabled="@(_typed != LockArbiter.ForceConfirmationText)"
                    @onclick="() => OnResolved.InvokeAsync(new Answer(true, false, _typed))">強制接手</button>
        }
    </Actions>
</Modal>

@code {
    public sealed record Answer(bool Proceed, bool ConfirmedStale, string? ForceText);

    private string _typed = "";

    [Parameter, EditorRequired] public LockDecision Decision { get; set; } = default!;

    [Parameter] public EventCallback<Answer> OnResolved { get; set; }
}
